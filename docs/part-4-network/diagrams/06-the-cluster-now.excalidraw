   "seed": 2126877775,
   "version": 1,
   "versionNonce": 1869965546,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Same node: pod -> veth -> cni0 -> veth -> pod.     Other node: pod -> cni0 -> flannel.1 (wrap in UDP) -> NIC -> virbr0 -> NIC -> flannel.1 (unwrap) -> cni0 -> pod.\nOut to the Internet: pod -> cni0 -> NIC (Flannel masquerade: becomes 192.168.122.x) -> virbr0 (libvirt NAT: becomes 192.168.1.25) -> wlo1 -> home router -> Internet.",
   "originalText": "Same node: pod -> veth -> cni0 -> veth -> pod.     Other node: pod -> cni0 -> flannel.1 (wrap in UDP) -> NIC -> virbr0 -> NIC -> flannel.1 (unwrap) -> cni0 -> pod.\nOut to the Internet: pod -> cni0 -> NIC (Flannel masquerade: becomes 192.168.122.x) -> virbr0 (libvirt NAT: becomes 192.168.1.25) -> wlo1 -> home router -> Internet.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
