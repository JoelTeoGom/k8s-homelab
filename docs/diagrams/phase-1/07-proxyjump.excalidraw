  {
   "type": "text",
   "id": "hLcPCq37mjCyWNrx",
   "x": 56,
   "y": 579.2,
   "width": 606.8000000000001,
   "height": 67.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ISZkhfUPe7tbXU6x"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 327807003,
   "version": 1,
   "versionNonce": 1295563569,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. ssh opens SSH #1 to the HP (your key).\n2. asks the HP: \"open a TCP socket to .10:22\".\n3. runs SSH #2 inside it, straight to cp-1 (your key again).",
   "originalText": "1. ssh opens SSH #1 to the HP (your key).\n2. asks the HP: \"open a TCP socket to .10:22\".\n3. runs SSH #2 inside it, straight to cp-1 (your key again).",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
