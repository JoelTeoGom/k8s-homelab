   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Chicken-and-egg: regular pods get their IP from the CNI, and the CNI is installed through the API server.\nSo the API server cannot need a pod IP: the whole control plane runs on the node's network, and works before the pod network exists.",
   "originalText": "Chicken-and-egg: regular pods get their IP from the CNI, and the CNI is installed through the API server.\nSo the API server cannot need a pod IP: the whole control plane runs on the node's network, and works before the pod network exists.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
